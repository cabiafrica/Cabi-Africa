# STAGE 1: Build
FROM node:20-alpine AS builder
WORKDIR /app

# Install ALL dependencies first
COPY package*.json ./
COPY tsconfig*.json ./
COPY nx.json ./
RUN npm ci --legacy-peer-deps

# Copy all source code
COPY . .

# Generate Prisma Client
RUN npx prisma generate --schema=libs/backend/database/prisma/schema.prisma

# Which service to build (e.g., auth-gateway)
ARG SERVICE_NAME
ENV SERVICE_NAME=${SERVICE_NAME}

# Build via Nx
RUN npx nx build ${SERVICE_NAME} --configuration=production

# STAGE 2: Production runner
FROM node:20-alpine AS runner
WORKDIR /app

ARG SERVICE_NAME
ENV NODE_ENV=production
ENV SERVICE_NAME=${SERVICE_NAME}

# Security: non-root user
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nestjs

# Copy compiled output
COPY --from=builder --chown=nestjs:nodejs /app/dist/${SERVICE_NAME} ./dist

# Copy the FULL node_modules (avoids missing dependency crashes on startup)
COPY --from=builder --chown=nestjs:nodejs /app/node_modules ./node_modules

USER nestjs

# Cloud Run injects PORT env var automatically
# The app reads process.env.PORT and falls back to 3333
EXPOSE 3333
CMD ["node", "dist/main.js"]
