{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@cabi/backend/user-service": [
        "libs/backend/user-service/src/index.ts"
      ],
      "@cabi/backend/database": [
        "libs/backend/database/src/index.ts"
      ],
      "@cabi/backend/ride-service": [
        "libs/backend/ride-service/src/index.ts"
      ],
      "@cabi/backend/payment-service": [
        "libs/backend/payment-service/src/index.ts"
      ],
      "@cabi/backend/notification-service": [
        "libs/backend/notification-service/src/index.ts"
      ],
      "@cabi/backend/sos-service": [
        "libs/backend/sos-service/src/index.ts"
      ],
      "@cabi/backend/admin-service": [
        "libs/backend/admin-service/src/index.ts"
      ],
      "@cabi/backend/auth": [
        "libs/backend/src/auth/index.ts"
      ],
      "@cabi/backend/sacco-service": [
        "libs/backend/sacco-service/src/index.ts"
      ],
      "@cabi/backend/analytics-service": [
        "libs/backend/analytics-service/src/index.ts"
      ],
      "@cabi/shared/types": [
        "libs/shared/types/src/index.ts"
      ],
      "@cabi/shared/utils": [
        "libs/shared/utils/src/index.ts"
      ],
      "@cabi/infrastructure/aws": [
        "libs/infrastructure/aws/src/index.ts"
      ],
      "@cabi/shared/interfaces": [
        "libs/shared/interfaces/index.ts"
      ],
      "@/components/*": [
        "Cabi Alpha/components/*"
      ],
      "@/user-portal/components/*": [
        "Cabi Alpha/web/user_portal/src/components/*"
      ],
      "@/admin-panel/src/*": [
        "Cabi Alpha/web/admin_panel/src/*"
      ],
      "@/backend/services/*": [
        "libs/backend/src/services/*"
      ],
      "@/shared/utils/*": [
        "libs/shared/utils/*"
      ],
      "@cabi/backend/rbac": [
        "libs/backend/rbac/src/index.ts"
      ],
      "@cabi/backend/dispatch-service": [
        "libs/backend/dispatch-service/src/index.ts"
      ],
      "@cabi/backend/settings": [
        "libs/backend/settings/src/index.ts"
      ],
      "@cabi/backend/common": [
        "libs/backend/common/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp",
    "tools/flutter",
    "dist",
    "**/node_modules",
    "**/.nx",
    "*.tsbuildinfo",
    ".tsbuildinfo"
  ]
}