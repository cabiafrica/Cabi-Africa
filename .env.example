# Development Environment Variables
# Copy this file to .env and update with your actual values

## Basic Configuration
COGNITO_USER_POOL_ID=mock_pool
COGNITO_CLIENT_ID=mock_client
AWS_REGION=us-east-1

## M-Pesa Configuration (Kenya)
# Get these from Safaricom Developer Portal: https://developer.safaricom.co.ke
MPESA_ENV=sandbox  # Use 'production' for live
MPESA_SHORT_CODE=174379
MPESA_PASSKEY=bfb279f9aa9b250cf06f1dd4422e779c298e7c0428aa9d309e6e18e57b4f1a3
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_INITIATOR_NAME=your_initiator_name
MPESA_SECURITY_CREDENTIAL=your_encrypted_security_credential

# M-Pesa Webhook URLs (must be publicly accessible)
MPESA_CALLBACK_URL=https://your-domain.com/mpesa/stk-callback
MPESA_TIMEOUT_URL=https://your-domain.com/mpesa/timeout
MPESA_RESULT_URL=https://your-domain.com/mpesa/result

## Database Configuration
# ⚡ OPTIMIZED: Connection pool settings for better performance
# 
# Parameters explained:
# - pgbouncer=true: Use PgBouncer session pooling
# - connection_limit=10: Max 10 concurrent connections per service
# - pool_timeout=30: 30 second timeout for acquiring connections
# - statement_cache_size=100: Cache up to 100 prepared statements
#
# Expected improvement: 30% faster queries, better connection management

# Session-pooled connection (use for app queries)
DATABASE_URL="postgresql://username:password@host:6543/database?pgbouncer=true&connection_limit=10&pool_timeout=30&statement_cache_size=100"

# Direct connection (use for migrations and admin operations)
DIRECT_URL="postgresql://username:password@host:5432/database"

## Google Maps Configuration
# Required for Geocoding, Places Autocomplete, and Map views
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

## Airtel Money (Airtel Africa Developers Portal)
AIRTEL_ENVIRONMENT=sandbox
AIRTEL_CLIENT_ID=your_airtel_client_id
AIRTEL_CLIENT_SECRET=your_airtel_client_secret
AIRTEL_PIN=your_airtel_merchant_pin
AIRTEL_COUNTRY=KE
AIRTEL_CURRENCY=KES
AIRTEL_CALLBACK_URL=https://www.cabi.africa/api/payments/airtel/callback

