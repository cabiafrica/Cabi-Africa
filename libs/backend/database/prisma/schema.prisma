enum ReferralStatus {
  PENDING_REVIEW
  AVAILABLE
  DISQUALIFIED
  CANCELLED
  FROZEN_FRAUD
}

enum ReferralType {
  DRIVER_TO_DRIVER
  PASSENGER_TO_PASSENGER
  PASSENGER_TO_DRIVER
}

enum FraudRule {
  DEVICE_FINGERPRINT_MATCH
  COLLUSIVE_TRIP_DENSITY
  CYCLIC_REFERRAL
  MULTI_ACCOUNT
}

// ─── Passenger Loyalty Points & Ledger ──────────────────────────────────────────

enum LoyaltyTransactionType {
  EARNED_RIDE_SPEND
  EARNED_RATING_BONUS
  EARNED_CHALLENGE
  REDEEMED_COUPON
  ADJUSTMENT
}

model LoyaltyTransaction {
  id           String                 @id @default(uuid())
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  points       Int
  balanceAfter Int
  type         LoyaltyTransactionType
  description  String
  metadata     Json?
  createdAt    DateTime               @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("loyalty_transactions")
}
