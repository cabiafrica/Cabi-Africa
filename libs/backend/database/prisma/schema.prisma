enum RoleType {
  // ADMIN PANEL ROLES
  SUPER_ADMIN
  ADMIN
  CONTENT_MANAGER
  USER_MANAGER
  OPERATIONS_MANAGER
  FINANCIAL_MANAGER
  VERIFICATION_OFFICER
  SUPPORT_AGENT

  // DISPATCH PANEL ROLES
  DISPATCHER
  SENIOR_DISPATCHER
  DISPATCH_SUPERVISOR
  DISPATCH_ANALYST

  // USER PORTAL ROLES
  MARKETING_ADMIN
  CONTENT_EDITOR
  BLOG_WRITER

  // DRIVER/PASSENGER ROLES
  DRIVER
  PASSENGER
  ORGANIZATION_ADMIN
  ORGANIZATION_MEMBER

  // LEGACY/UTILITY ROLES
  VIEWER
  AUDITOR
  GUEST
}

enum Platform {
  ADMIN_PANEL
  DISPATCH_PANEL
  USER_PORTAL
  MOBILE_APP
  ALL
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?  @db.Text
  type        RoleType
  platform    Platform

  // Permissions
  permissions Permission[]

  // Hierarchy
  parentRoleId String?
  parentRole   Role?   @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  childRoles   Role[]  @relation("RoleHierarchy")

  isActive Boolean @default(true)
  isSystem Boolean @default(false) // System roles cannot be deleted

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  // Scope (optional - for multi-tenancy)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  assignedById String?
  assignedBy   User?     @relation("AssignedRoles", fields: [assignedById], references: [id])
  assignedAt   DateTime  @default(now())
  expiresAt    DateTime?

  isActive Boolean @default(true)

  @@unique([userId, roleId, organizationId])
  @@map("user_roles")
}

model UserPermission {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  permission Permission
  isGranted  Boolean    @default(true) // true = Grant (add), false = Revoke (override)

  assignedById String?
  assignedBy   User?    @relation("AssignedPermissions", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  @@unique([userId, permission])
  @@map("user_permissions")
}

enum VehicleType {
  STANDARD
  PREMIUM
  XL
  BODA
}

enum RideStatus {
  REQUESTED
  MATCHING
  DRIVER_ASSIGNED
  DRIVER_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  hunterId String
  hunter   OrganizationMember @relation("HunterInvitations", fields: [hunterId], references: [id])

  driverId String
  driver   DriverProfile @relation(fields: [driverId], references: [id])

  status    InvitationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Document Verification Models
model DocumentVerification {
  id               String                   @id @default(uuid())
  userId           String
  user             User                     @relation(fields: [userId], references: [id])
  documentType     VerificationDocumentType
  documentImageUrl String                   @db.Text // Compressed image URL
  fileSize         Int? // File size in bytes
  mimeType         String? // image/jpeg, image/png

  // OCR Extracted Data
  extractedData Json? // Stores OCR results

  // Validation Results
  isValid          Boolean @default(false)
  validationErrors Json? // Array of validation errors
  confidenceScore  Float? // OCR confidence 0-1

  status     VerificationStatus @default(PENDING)
  verifiedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  // Relation to biometric verification
  biometricVerifications BiometricVerification[]

  @@map("document_verifications")
}

model BiometricVerification {
  id                     String               @id @default(uuid())
  userId                 String
  user                   User                 @relation(fields: [userId], references: [id])
  documentVerificationId String
  documentVerification   DocumentVerification @relation(fields: [documentVerificationId], references: [id])

  selfieImageUrl String  @db.Text // Compressed selfie URL
  fileSize       Int? // File size in bytes
  mimeType       String? // image/jpeg

  // Verification Results
  matchScore    Float? // Face match score 0-1
  livenessScore Float? // Liveness detection 0-1
  isMatch       Boolean @default(false)
  isLive        Boolean @default(false)

  status     VerificationStatus @default(PENDING)
  verifiedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@map("biometric_verifications")
}

enum VerificationDocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
}

enum VerificationStatus {
  PENDING
  PROCESSING
  VERIFIED
  FAILED
  EXPIRED
}

// ============================================
// OCCURRENCE BOOK SYSTEM
// ============================================

enum OccurrenceCategory {
  CRIME
  TRAFFIC_OFFENSE
  SAFETY_VIOLATION
  POLICY_VIOLATION
  HARASSMENT
  FRAUD
  PROPERTY_DAMAGE
  MEDICAL_EMERGENCY
  DISPUTE
  SUSPICIOUS_ACTIVITY
  VEHICLE_ISSUE
  ENVIRONMENTAL
}

enum OccurrenceSeverity {
  CRITICAL // SEV-1
  HIGH // SEV-2
  MEDIUM // SEV-3
  LOW // SEV-4
}

enum OccurrenceStatus {
  OPEN
  UNDER_INVESTIGATION
  RESOLVED
  DISPUTED
}

enum ObjectionStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

model Occurrence {
  id       String @id @default(uuid())
  obNumber String @unique @map("ob_number")

  // Categorization
  category    OccurrenceCategory
  severity    OccurrenceSeverity
  title       String             @db.VarChar(255)
  description String             @db.Text

  // Involved parties
  driverId    String?        @map("driver_id")
  driver      DriverProfile? @relation("DriverOccurrences", fields: [driverId], references: [id])
  passengerId String?        @map("passenger_id")
  passenger   User?          @relation("PassengerOccurrences", fields: [passengerId], references: [id])
  vehicleId   String?        @map("vehicle_id")
  vehicle     Vehicle?       @relation("VehicleOccurrences", fields: [vehicleId], references: [id])
  rideId      String?        @map("ride_id")
  ride        Ride?          @relation("RideOccurrences", fields: [rideId], references: [id])

  // TIME, DATE, and PLACE (Critical Fields)
  occurrenceDate DateTime @map("occurrence_date") @db.Date
  occurrenceTime DateTime @map("occurrence_time") @db.Time
  occurredAt     DateTime @map("occurred_at")

  // Location Details
  locationLat       Decimal? @map("location_lat") @db.Decimal(10, 8)
  locationLng       Decimal? @map("location_lng") @db.Decimal(11, 8)
  locationAddress   String?  @map("location_address") @db.Text
  locationPlaceName String?  @map("location_place_name") @db.VarChar(255)
  locationCity      String?  @map("location_city") @db.VarChar(100)
  locationCountry   String   @default("Kenya") @map("location_country") @db.VarChar(100)
  locationDetails   Json?    @map("location_details")

  // Source
  source            String // 'SOS', 'RATING', 'COMMENT', 'MANUAL', 'AUTO'
  sourceReferenceId String? @map("source_reference_id")

  // Registrar
  registeredById String   @map("registered_by")
  registeredBy   User     @relation("RegisteredOccurrences", fields: [registeredById], references: [id])
  registeredAt   DateTime @default(now()) @map("registered_at")

  // Status
  status          OccurrenceStatus @default(OPEN)
  resolvedAt      DateTime?        @map("resolved_at")
  resolvedById    String?          @map("resolved_by")
  resolvedBy      User?            @relation("ResolvedOccurrences", fields: [resolvedById], references: [id])
  resolutionNotes String?          @map("resolution_notes") @db.Text

  // Metadata
  tags       String[]
  isFlagged  Boolean  @default(false) @map("is_flagged")
  flagReason String?  @map("flag_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  media      OccurrenceMedia[]
  objections OccurrenceObjection[]
  auditLog   OccurrenceAuditLog[]

  @@index([status])
  @@index([severity])
  @@index([category])
  @@index([occurrenceDate])
  @@index([driverId])
  @@index([passengerId])
  @@map("occurrences")
}

model OccurrenceMedia {
  id           String     @id @default(uuid())
  occurrenceId String     @map("occurrence_id")
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  mediaType    String  @map("media_type") // 'PHOTO', 'VIDEO', 'AUDIO', 'DOCUMENT'
  fileUrl      String  @map("file_url") @db.Text
  thumbnailUrl String? @map("thumbnail_url") @db.Text
  fileSize     Int?    @map("file_size")
  mimeType     String? @map("mime_type") @db.VarChar(100)
  duration     Int? // For audio/video in seconds

  uploadedById String?  @map("uploaded_by")
  uploadedBy   User?    @relation("UploadedOccurrenceMedia", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  description String? @db.Text
  metadata    Json?

  @@map("occurrence_media")
}

model OccurrenceObjection {
  id           String     @id @default(uuid())
  occurrenceId String     @map("occurrence_id")
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  objectorId         String @map("objector_id")
  objector           User   @relation("FiledObjections", fields: [objectorId], references: [id])
  objectionText      String @map("objection_text") @db.Text
  supportingEvidence Json?  @map("supporting_evidence")

  status ObjectionStatus @default(PENDING)

  reviewedById String?   @map("reviewed_by")
  reviewedBy   User?     @relation("ReviewedObjections", fields: [reviewedById], references: [id])
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNotes  String?   @map("review_notes") @db.Text
  outcome      String?   @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("occurrence_objections")
}

model OccurrenceAuditLog {
  id           String     @id @default(uuid())
  occurrenceId String     @map("occurrence_id")
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  action  String  @db.VarChar(50)
  actorId String? @map("actor_id")
  actor   User?   @relation("OccurrenceAuditActions", fields: [actorId], references: [id])
  changes Json?
  notes   String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@map("occurrence_audit_log")
}

// ============================================
// BADGE SYSTEM
// ============================================

enum BadgeCategory {
  ACHIEVEMENT // Ride milestones
  QUALITY // High ratings
  LOYALTY // Long-term usage
  SAFETY // Safety features usage
  SOCIAL // Referrals, sharing
  SPECIAL // Limited edition, events
}

enum BadgeTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND

  // Gamified Sacco System Tiers
  ROOKIE       // First 50 trips - grace period
  STAR_DRIVER  // 100+ trips, 4.5+ rating
  ROAD_MASTER  // 500+ trips, 4.7+ rating, <5% cancellation
  ELITE        // Top 10% performers - invitation only
}

model Badge {
  id          String        @id @default(uuid())
  code        String        @unique // e.g., "FIRST_RIDE", "CENTURY_CLUB"
  name        String
  description String        @db.Text
  iconUrl     String?       @db.Text
  category    BadgeCategory
  tier        BadgeTier     @default(BRONZE)

  // Earning criteria (stored as JSON for flexibility)
  criteria Json // { type: "RIDES_COMPLETED", threshold: 100 }

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  userBadges           UserBadge[]
  badgeRewardMappings  BadgeRewardMapping[]

  @@map("badges")
}

model UserBadge {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  badgeId String
  badge   Badge  @relation(fields: [badgeId], references: [id])

  earnedAt        DateTime       @default(now())
  progress        Int? // For progressive badges (e.g., 75/100 rides)
  DriverProfile   DriverProfile? @relation(fields: [driverProfileId], references: [id])
  driverProfileId String?

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ============================================
// GAMIFIED SACCO SYSTEM - REWARDS & PRIVILEGES
// ============================================

enum RewardType {
  PRIORITY_DISPATCH    // Priority in driver matching queue
  ZONE_SELECTION       // Geofencing zone preference access
  COMMISSION_REBATE    // Reduced platform commission
  SACCO_BONUS          // Additional Sacco contribution (3%)
  SACCO_MATCH          // Platform matching of savings
  CREDIT_LIMIT_BOOST  // Higher loan limits
  LOAN_RATE_REDUCTION // Lower interest rates on loans
  PASSENGER_DISCOUNT  // Discounted fares for passengers
}

model Reward {
  id          String     @id @default(uuid())
  code        String     @unique // e.g., "PRIORITY_DISPATCH", "ZONE_ACCESS"
  name        String
  description String     @db.Text
  type        RewardType
  value       Json       // { percentage: 3, maxAmount: null } or { maxZones: 3 }

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  badgeRewardMappings BadgeRewardMapping[]

  @@map("rewards")
}

model BadgeRewardMapping {
  id        String   @id @default(uuid())
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  rewardId  String
  reward    Reward   @relation(fields: [rewardId], references: [id])

  isActive Boolean @default(true)
  createdAt DateTime @default(now())

  @@unique([badgeId, rewardId])
  @@map("badge_reward_mappings")
}

// Driver Badge Status - tracks active/inactive status and expiry
model DriverBadgeStatus {
  id                String    @id @default(uuid())
  driverProfileId   String
  driverProfile     DriverProfile @relation(fields: [driverProfileId], references: [id])
  badgeTier         BadgeTier // ROOKIE, STAR_DRIVER, ROAD_MASTER, ELITE

  isActive         Boolean   @default(true)
  earnedAt          DateTime  @default(now())
  expiresAt         DateTime? // Nullable - null means no expiry
  lastValidatedAt   DateTime? // Last time badge criteria were checked

  // Metrics snapshot at time of earning
  metricsSnapshot   Json?     // { totalRides: 100, averageRating: 4.5, cancellationRate: 3.2 }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([driverProfileId, badgeTier])
  @@map("driver_badge_status")
}

// Driver Savings Preferences
model DriverSavingsPreference {
  id                  String   @id @default(uuid())
  driverProfileId     String   @unique
  driverProfile       DriverProfile @relation(fields: [driverProfileId], references: [id])

  personalSavingRate  Float    @default(0.0) // 0-30% of driver share, voluntary deduction
  isAutoSavingsEnabled Boolean @default(false)

  // Preferred zones for geofencing (if applicable)
  preferredZoneIds    String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("driver_savings_preferences")
}

// Transaction Ledger - tracks all commission/sacco calculations
model TransactionLedger {
  id                    String   @id @default(uuid())
  tripId                String?
  driverProfileId       String
  driverProfile         DriverProfile @relation(fields: [driverProfileId], references: [id])

  baseFare              Decimal  @db.Decimal(10, 2)

  // Commission breakdown (all amounts in KES)
  platformCommission    Decimal  @db.Decimal(10, 2)     // 20% of fare
  platformNet           Decimal  @db.Decimal(10, 2)     // 15% (or 17-20% based on badge)
  saccoAdminFee         Decimal  @db.Decimal(10, 2)     // 2% compulsory

  // Badge-related amounts
  badgeBonusActive      Boolean  @default(false)
  badgeBonusAmount      Decimal  @db.Decimal(10, 2)     // 3% if active

  // Driver savings
  personalSavingsAmount Decimal  @db.Decimal(10, 2)     // Voluntary savings from driver share

  // Final amounts
  driverShare           Decimal  @db.Decimal(10, 2)     // 80% of fare
  driverNetTakeHome     Decimal  @db.Decimal(10, 2)   // After all deductions
  totalSaccoDeposit    Decimal  @db.Decimal(10, 2)    // 2% + 3% + personal

  // Commission rebate (if badge holder)
  commissionRebate      Decimal  @db.Decimal(10, 2)    // Reduced platform take

  // Status
  isFlagged             Boolean  @default(false) // Flagged if deductions > 50%
  flagReason            String?  @db.Text

  createdAt DateTime @default(now())

  @@index([driverProfileId])
  @@index([tripId])
  @@index([createdAt])
  @@map("transaction_ledger")
}

// ============================================
// RIDE PREFERENCES
// ============================================

model RidePreference {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Matching preferences
  preferredVehicleTypes VehicleType[]
  maxWaitMinutes        Int           @default(10)
  maxDistanceKm         Float         @default(5.0)

  // Ride preferences
  quietRide    Boolean @default(false)
  musicAllowed Boolean @default(true)
  acPreferred  Boolean @default(false)
  petFriendly  Boolean @default(false)

  // Favorite drivers
  favoriteDriverIds String[]
  blockedDriverIds  String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ride_preferences")
}
