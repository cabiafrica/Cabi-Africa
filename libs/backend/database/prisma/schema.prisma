generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  PROSPECT
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

model User {
  id               String     @id @default(uuid())
  email            String     @unique
  phone            String     @unique
  password         String
  fullName         String
  city             String?
  username         String?    @unique
  nickname         String?
  middleName       String?
  idNumber         String?    @unique
  passportPhotoUrl String?    @db.Text // Stores compressed image URL or base64
  privacySettings  Json?      @default("{}") // { showEmail: boolean, showPhone: boolean, showRealName: boolean }
  role             LegacyRole @default(PASSENGER)
  status           UserStatus @default(PROSPECT)

  // 2FA and Security
  isTwoFactorEnabled    Boolean   @default(false)
  twoFactorSecret       String?
  recoveryCodes         String[]
  forgotEmailOtp        String?
  forgotEmailOtpExpires DateTime?
  lastActiveAt          DateTime?

  // RBAC Relations
  userRoles           UserRole[]
  userPermissions     UserPermission[]
  assignedRoles       UserRole[]       @relation("AssignedRoles")
  assignedPermissions UserPermission[] @relation("AssignedPermissions")

  // Verification Status
  isEmailVerified    Boolean @default(false)
  isPhoneVerified    Boolean @default(false)
  isIdentityVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Gamification & Stats
  totalRidesAsPassenger Int             @default(0)
  averageRating         Float?
  badges                UserBadge[]
  ridePreference        RidePreference?

  // Relations
  ridesAsPassenger       Ride[]                  @relation("PassengerRides")
  driverProfile          DriverProfile?
  documentVerifications  DocumentVerification[]
  biometricVerifications BiometricVerification[]
  loginHistory           LoginHistory[]

  // Referrals
  referralCode String? @unique
  referredById String?
  referredBy   User?   @relation("UserReferrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("UserReferrals")

  // Organization Membership
  orgMemberProfile OrganizationMember?

  // Occurrence Book Relations
  occurrencesAsPassenger Occurrence[]          @relation("PassengerOccurrences")
  registeredOccurrences  Occurrence[]          @relation("RegisteredOccurrences")
  resolvedOccurrences    Occurrence[]          @relation("ResolvedOccurrences")
  uploadedMedia          OccurrenceMedia[]     @relation("UploadedOccurrenceMedia")
  filedObjections        OccurrenceObjection[] @relation("FiledObjections")
  reviewedObjections     OccurrenceObjection[] @relation("ReviewedObjections")
  auditActions           OccurrenceAuditLog[]  @relation("OccurrenceAuditActions")

  @@index([role])
  @@index([createdAt])
  @@index([email])
  @@index([phone])
  @@map("users")
}

model LoginHistory {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  ipAddress  String
  userAgent  String
  location   String?
  reportedAt DateTime?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("login_history")
}

// ... existing enums

enum OrganizationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

model Organization {
  id                         String             @id @default(uuid())
  name                       String
  founderName                String?
  email                      String             @unique
  bio                        String?            @db.Text
  logoUrl                    String?            @db.Text // Compressed logo image
  bannerUrl                  String?            @db.Text // Compressed banner image
  primaryColor               String?
  secondaryColor             String?
  website                    String?
  twitter                    String?
  facebook                   String?
  instagram                  String?
  linkedin                   String?
  registrationNumber         String             @unique
  registrationCertificateUrl String?            @db.Text // Compressed certificate document
  status                     OrganizationStatus @default(UNVERIFIED)

  // Sub-organization hierarchy
  parentId String?
  parent   Organization?  @relation("SubOrgs", fields: [parentId], references: [id])
  children Organization[] @relation("SubOrgs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     OrganizationMember[]
  drivers     DriverProfile[]
  invitations Invitation[]
  userRoles   UserRole[]

  @@map("organizations")
}

model OrganizationMember {
  id                  String       @id @default(uuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  name                String
  contact             String
  position            String
  duties              String?
  isBiometricVerified Boolean      @default(false)

  // Hunter Features
  userId          String?      @unique
  user            User?        @relation(fields: [userId], references: [id])
  canHunt         Boolean      @default(false)
  sentInvitations Invitation[] @relation("HunterInvitations")

  @@map("organization_members")
}

model DriverGroup {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  
  // Hierarchy support
  parentGroupId String?
  parentGroup   DriverGroup?  @relation("SubGroups", fields: [parentGroupId], references: [id])
  subgroups     DriverGroup[] @relation("SubGroups")
  
  // Members
  drivers DriverProfile[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("driver_groups")
}

// In DriverProfile - updating existing model
model DriverProfile {
  id                  String  @id @default(uuid())
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id])
  licenseNumber       String  @unique
  isOnline            Boolean @default(false)
  currentLocation     Json? // { lat: number, lng: number }
  isBiometricVerified Boolean @default(false)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  
  // Group membership
  driverGroupId String?
  driverGroup   DriverGroup? @relation(fields: [driverGroupId], references: [id])
  
  // MLM Referral tracking
  referrerId String?
  referrer   DriverProfile?  @relation("DriverReferrals", fields: [referrerId], references: [id])
  referrals  DriverProfile[] @relation("DriverReferrals")

  // Gamification & Stats
  totalRidesCompleted Int         @default(0)
  averageRating       Float?
  acceptanceRate      Float? // Percentage of accepted ride requests
  badges              UserBadge[]
  badgeStatus         DriverBadgeStatus[]

  // Savings & Sacco
  savingsPreference   DriverSavingsPreference?
  transactionLedger   TransactionLedger[]

  // Relations
  vehicle             Vehicle?
  ridesAsDriver       Ride[]       @relation("DriverRides")
  receivedInvitations Invitation[]
  documents           Document[]
  occurrences         Occurrence[] @relation("DriverOccurrences")

  @@index([isOnline])
  @@index([organizationId])
  @@index([driverGroupId])
  @@index([referrerId])
  @@map("driver_profiles")
}

model Document {
  id              String         @id @default(uuid())
  driverProfileId String
  driverProfile   DriverProfile  @relation(fields: [driverProfileId], references: [id])
  type            DocumentType
  url             String         @db.Text // Stores compressed image URL
  thumbnailUrl    String?        @db.Text // Optional thumbnail
  fileSize        Int? // File size in bytes
  mimeType        String? // image/jpeg, image/png, etc.
  status          DocumentStatus @default(PENDING)
  rejectionReason String?        @db.Text
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("documents")
}

enum DocumentType {
  LICENSE_FRONT
  LICENSE_BACK
  ID_FRONT
  ID_BACK
  PROFILE_PHOTO
  VEHICLE_LOGBOOK
  VEHICLE_INSURANCE
  VEHICLE_INSPECTION
  POLICE_CLEARANCE
  PSV_BADGE
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// ... existing models (User, Vehicle, Ride) and enums
model Vehicle {
  id                      String         @id @default(uuid())
  driverProfileId         String         @unique
  driverProfile           DriverProfile  @relation(fields: [driverProfileId], references: [id])
  make                    String
  model                   String
  year                    Int
  color                   String?
  plateNumber             String         @unique
  logbookNumber           String?        @unique
  insurancePolicyNumber   String?
  insuranceExpiry         DateTime?
  insuranceCertificateUrl String?        @db.Text // Compressed document URL
  logbookImageUrl         String?        @db.Text // Compressed document URL
  inspectionReportUrl     String?        @db.Text // Compressed document URL
  frontPhotoUrl           String?        @db.Text // Compressed image URL
  backPhotoUrl            String?        @db.Text // Compressed image URL
  sidePhotoUrl            String?        @db.Text // Compressed image URL
  type                    VehicleType    @default(STANDARD)
  usage                   VehicleUsage   @default(TAXI)
  insuranceType           InsuranceType?

  // Owner Details
  ownerName  String?
  ownerPhone String?

  // Capacity Details
  capacity     Float?
  capacityUnit String? // 'PASSENGERS', 'TONS', 'KG'

  occurrences Occurrence[] @relation("VehicleOccurrences")

  @@map("vehicles")
}

enum VehicleUsage {
  TAXI
  COMMERCIAL
  PRIVATE
  INSTITUTIONAL
}

enum InsuranceType {
  PSV
  COMMERCIAL
  PRIVATE
}

model Ride {
  id          String         @id @default(uuid())
  passengerId String
  passenger   User           @relation("PassengerRides", fields: [passengerId], references: [id])
  driverId    String?
  driver      DriverProfile? @relation("DriverRides", fields: [driverId], references: [id])

  status RideStatus @default(REQUESTED)

  pickupLocation  Json // { lat, lng, address }
  dropoffLocation Json // { lat, lng, address }

  fare     Decimal? @db.Decimal(10, 2)
  distance Float? // In km
  duration Int? // In minutes

  // Matching & Pricing
  requestedVehicleType VehicleType?
  matchingStartedAt    DateTime?
  matchingCompletedAt  DateTime?
  matchingDurationMs   Int? // Time to find driver in milliseconds
  surgeMultiplier      Float?       @default(1.0)
  baseFare             Decimal?     @db.Decimal(10, 2)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  occurrences Occurrence[] @relation("RideOccurrences")

  @@index([passengerId])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
  @@map("rides")
}

enum LegacyRole {
  PASSENGER
  DRIVER
  ADMIN
  DISPATCHER
}

