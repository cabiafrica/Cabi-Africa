model BlogPost {
  id            String     @id @default(uuid())
  title         String
  slug          String     @unique
  summary       String
  content       String
  imageUrl      String?
  status        PostStatus @default(DRAFT)
  authorName    String
  publishedDate DateTime?
  category      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("blog_posts")
}

enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
}
