generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                     @id @default(uuid())
  email                  String                     @unique
  phone                  String                     @unique
  password               String
  fullName               String
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  nickname               String?
  privacySettings        Json?                      @default("{}")
  referralCode           String?                    @unique
  referredById           String?
  username               String?                    @unique
  idNumber               String?                    @unique
  middleName             String?
  passportPhotoUrl       String?
  isEmailVerified        Boolean                    @default(false)
  isPhoneVerified        Boolean                    @default(false)
  isIdentityVerified     Boolean                    @default(false)
  role                   LegacyRole                 @default(PASSENGER)
  city                   String?
  status                 UserStatus                 @default(PROSPECT)
  forgotEmailOtp         String?
  forgotEmailOtpExpires  DateTime?
  resetPasswordToken     String?
  resetPasswordExpires   DateTime?
  phoneOtpCode           String?
  phoneOtpExpires        DateTime?
  isTwoFactorEnabled     Boolean                    @default(false)
  lastActiveAt           DateTime?
  recoveryCodes          String[]
  twoFactorSecret        String?
  averageRating          Float?
  totalRidesAsPassenger  Int                        @default(0)
  fingerprintDataUrl     String?
  isVerifiedPassenger    Boolean                    @default(false)
  lastVerificationAt     DateTime?
  maxFreeTrips           Int                        @default(1)
  passengerTripCount     Int                        @default(0)
  verificationLevel      PassengerVerificationLevel @default(BASIC)
  biometricVerifications BiometricVerification[]
  documentVerifications  DocumentVerification[]
  driverProfile          DriverProfile?
  loginHistory           LoginHistory[]
  auditActions           OccurrenceAuditLog[]       @relation("OccurrenceAuditActions")
  uploadedMedia          OccurrenceMedia[]          @relation("UploadedOccurrenceMedia")
  filedObjections        OccurrenceObjection[]      @relation("FiledObjections")
  reviewedObjections     OccurrenceObjection[]      @relation("ReviewedObjections")
  occurrencesAsPassenger Occurrence[]               @relation("PassengerOccurrences")
  registeredOccurrences  Occurrence[]               @relation("RegisteredOccurrences")
  resolvedOccurrences    Occurrence[]               @relation("ResolvedOccurrences")
  organization_members   organization_members?
  ridePreference         RidePreference?
  ridesAsPassenger       Ride[]                     @relation("PassengerRides")
  loyaltyPoints          Int                        @default(0)
  loyaltyTransactions    LoyaltyTransaction[]
  badges                 UserBadge[]
  assignedPermissions    UserPermission[]           @relation("AssignedPermissions")
  userPermissions        UserPermission[]
  assignedRoles          UserRole[]                 @relation("AssignedRoles")
  userRoles              UserRole[]
  referredBy             User?                      @relation("UserReferrals", fields: [referredById], references: [id])
  referrals              User[]                     @relation("UserReferrals")
  deviceId               String?
  imeiHash               String?
  registrationIp         String?
  referralRelationships ReferralRelationship[]     @relation("ReferrerRelationships")
  referredRelationships ReferralRelationship[]     @relation("RefereeRelationships")
  referralCommissions    ReferralCommissionLedger[] @relation("UserReferralCommissions")
  sourceReferralCommissions ReferralCommissionLedger[] @relation("SourceReferralCommissions")
  notificationLogs       NotificationLog[]
  referralFraudAlerts    ReferralFraudAlert[]       @relation("UserFraudAlerts")
  relatedFraudAlerts     ReferralFraudAlert[]       @relation("RelatedFraudAlerts")
  fleetManagerProfile    FleetManager?

  @@index([role])
  @@index([createdAt])
  @@index([email])
  @@index([phone])
  @@index([lastActiveAt])
  @@index([isTwoFactorEnabled])
  @@map("users")
}

model LoginHistory {
  id         String    @id @default(uuid())
  userId     String
  ipAddress  String
  userAgent  String
  location   String?
  reportedAt DateTime?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])

  @@map("login_history")
}

model DriverProfile {
  id                  String                   @id @default(uuid())
  userId              String                   @unique
  licenseNumber       String                   @unique
  isOnline            Boolean                  @default(false)
  currentLocation     Json?
  isBiometricVerified Boolean                  @default(false)
  organizationId      String?
  acceptanceRate      Float?
  averageRating       Float?
  totalRidesCompleted Int                      @default(0)
  driverGroupId       String?
  referrerId          String?
  commissionLedger    CommissionLedger[]
  commissionSource    CommissionLedger[]       @relation("CommissionSource")
  referralCommissions ReferralCommissionLedger[] @relation("DriverReferralCommissions")
  sourceReferralCommissions ReferralCommissionLedger[] @relation("SourceDriverReferralCommissions")
  documents           Document[]
  badgeStatus         DriverBadgeStatus[]
  driver_groups       driver_groups?           @relation(fields: [driverGroupId], references: [id])
  organizations       organizations?           @relation(fields: [organizationId], references: [id])
  referrer            DriverProfile?           @relation("DriverReferrals", fields: [referrerId], references: [id])
  referrals           DriverProfile[]          @relation("DriverReferrals")
  user                User                     @relation(fields: [userId], references: [id])
  savingsPreference   DriverSavingsPreference?
  receivedInvitations Invitation[]
  occurrences         Occurrence[]             @relation("DriverOccurrences")
  ridesAsDriver       Ride[]                   @relation("DriverRides")
  saccoLedger         SaccoLedger[]
  transactionLedger   TransactionLedger[]
  badges              UserBadge[]
  vehicles            Vehicle?                 // legacy 1-to-1 (kept for backward compat)
  vehicleDrivers      VehicleDriver[]          // assigned vehicles (new multi-car support)
  vehicleShifts       VehicleShift[]           // shift history
  benefitClaims       VehicleBenefitClaim[]    // self-reported maintenance
  welfareEnrollments  WelfareEnrollment[]
  welfareDeductions   WelfareDeduction[]
  wealthEnrollments   DriverWealthEnrollment[]

  // External Sacco & Financial Services integration
  saccoEnrolled       Boolean                  @default(false)
  saccoPartnerId      String?
  saccoEnrolledAt     DateTime?
  saccoPartner        SaccoPartner?            @relation(fields: [saccoPartnerId], references: [id])
  financialConsents   DriverFinancialConsent[]

  // Driver Destination Mode & Excluded Zones
  preferredDestination Json?
  excludedZones        Json?

  @@index([isOnline])
  @@index([referrerId])
  @@index([driverGroupId])
  @@index([organizationId])
  @@map("driver_profiles")
}

model Document {
  id              String         @id @default(uuid())
  driverProfileId String
  type            DocumentType
  url             String
  status          DocumentStatus @default(PENDING)
  rejectionReason String?
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  thumbnailUrl    String?
  fileSize        Int?
  mimeType        String?
  driverProfile   DriverProfile  @relation(fields: [driverProfileId], references: [id])

  @@map("documents")
}

model Vehicle {
  id                      String          @id @default(uuid())
  // Legacy 1-to-1 driver link — kept nullable for backward compat during migration
  driverProfileId         String?         @unique
  // Fleet manager who owns this vehicle (nullable for legacy records)
  fleetManagerId          String?
  make                    String
  model                   String
  year                    Int
  plateNumber             String          @unique
  type                    VehicleType     @default(STANDARD)
  backPhotoUrl            String?
  color                   String?
  frontPhotoUrl           String?
  inspectionReportUrl     String?
  insuranceCertificateUrl String?
  insuranceExpiry         DateTime?
  insurancePolicyNumber   String?
  logbookNumber           String?         @unique
  sidePhotoUrl            String?
  insuranceType           InsuranceType?
  usage                   VehicleUsage    @default(TAXI)
  logbookImageUrl         String?
  ownerName               String?
  ownerPhone              String?
  capacity                Float?
  capacityUnit            String?
  isShared                Boolean         @default(false)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  occurrences             Occurrence[]    @relation("VehicleOccurrences")
  driver_profiles         DriverProfile?  @relation(fields: [driverProfileId], references: [id])
  fleetManager            FleetManager?   @relation(fields: [fleetManagerId], references: [id])
  vehicleDrivers          VehicleDriver[]
  vehicleShifts           VehicleShift[]
  benefitClaims           VehicleBenefitClaim[]

  @@map("vehicles")
}

// --- Fleet Management ---

model FleetManager {
  id          String    @id @default(uuid())
  userId      String    @unique
  companyName String?
  phone       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])
  vehicles    Vehicle[]

  @@map("fleet_managers")
}

// Drivers assigned to a vehicle by the fleet manager (allowed to drive it)
model VehicleDriver {
  id              String              @id @default(uuid())
  vehicleId       String
  driverProfileId String
  assignedAt      DateTime            @default(now())
  removedAt       DateTime?
  isActive        Boolean             @default(true)
  vehicle         Vehicle             @relation(fields: [vehicleId], references: [id])
  driver          DriverProfile       @relation(fields: [driverProfileId], references: [id])

  @@unique([vehicleId, driverProfileId])
  @@index([vehicleId, isActive])
  @@index([driverProfileId, isActive])
  @@map("vehicle_drivers")
}

// Tracks who is currently driving which car — enforces mutual exclusivity
model VehicleShift {
  id              String        @id @default(uuid())
  vehicleId       String
  driverProfileId String
  startedAt       DateTime      @default(now())
  endedAt         DateTime?
  status          ShiftStatus   @default(ACTIVE)
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id])
  driver          DriverProfile @relation(fields: [driverProfileId], references: [id])

  @@index([vehicleId, status])
  @@index([driverProfileId, status])
  @@map("vehicle_shifts")
}

// --- Vehicle Benefits & Qualifications ---

// Admin-defined service benefit catalogue
model VehicleBenefit {
  id           String                   @id @default(uuid())
  name         String                   @unique
  description  String?
  category     String                   // MAINTENANCE | SAFETY | COMPLIANCE | COSMETIC
  iconEmoji    String?                  @default("🔧")
  isActive     Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  claims       VehicleBenefitClaim[]
  requirements QualificationRequirement[]

  @@map("vehicle_benefits")
}

// Driver self-reports a maintenance action — pending admin approval
model VehicleBenefitClaim {
  id                 String         @id @default(uuid())
  vehicleId          String
  benefitId          String
  reportedByDriverId String
  reportedAt         DateTime       @default(now())
  evidenceUrl        String?
  notes              String?
  status             ClaimStatus    @default(PENDING)
  reviewedAt         DateTime?
  reviewedByAdminId  String?
  rejectionReason    String?
  vehicle            Vehicle        @relation(fields: [vehicleId], references: [id])
  benefit            VehicleBenefit @relation(fields: [benefitId], references: [id])
  driver             DriverProfile  @relation(fields: [reportedByDriverId], references: [id])

  @@index([vehicleId, status])
  @@index([status])
  @@map("vehicle_benefit_claims")
}

// Admin-defined qualification tiers (e.g. "Branded Car Program")
model VehicleQualification {
  id              String                     @id @default(uuid())
  name            String                     @unique
  description     String?
  rewardLabel     String
  rewardIconEmoji String?                    @default("🏆")
  isActive        Boolean                    @default(true)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  requirements    QualificationRequirement[]

  @@map("vehicle_qualifications")
}

// Which benefits are required to unlock a qualification
model QualificationRequirement {
  qualificationId String
  benefitId       String
  qualification   VehicleQualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade)
  benefit         VehicleBenefit       @relation(fields: [benefitId], references: [id], onDelete: Cascade)

  @@id([qualificationId, benefitId])
  @@map("qualification_requirements")
}

model Ride {
  id                   String         @id @default(uuid())
  passengerId          String
  driverId             String?
  status               RideStatus     @default(REQUESTED)
  pickupLocation       Json
  dropoffLocation      Json
  fare                 Decimal?       @db.Decimal(10, 2)
  distance             Float?
  duration             Int?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  baseFare             Decimal?       @db.Decimal(10, 2)
  matchingCompletedAt  DateTime?
  matchingDurationMs   Int?
  matchingStartedAt    DateTime?
  driverArrivedAt      DateTime?
  requestedVehicleType VehicleType?
  surgeMultiplier      Float?         @default(1.0)
  passedDriverIds      String[]       @default([])
  assignmentExpiresAt  DateTime?
  tripCode             String?
  occurrences          Occurrence[]   @relation("RideOccurrences")
  stops                RideStop[]
  driver               DriverProfile? @relation("DriverRides", fields: [driverId], references: [id])
  passenger            User           @relation("PassengerRides", fields: [passengerId], references: [id])

  @@index([passengerId])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
  @@index([tripCode])
  @@map("rides")
}

model RideStop {
  id        String     @id @default(uuid())
  rideId    String
  address   String
  location  Json
  stopOrder Int        @default(1)
  status    StopStatus @default(PENDING)
  arrivedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  ride      Ride       @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId])
  @@map("ride_stops")
}

enum StopStatus {
  PENDING
  ARRIVED
  COMPLETED
}

model Role {
  id           String       @id @default(uuid())
  name         String       @unique
  displayName  String
  description  String?
  type         RoleType
  platform     Platform
  permissions  Permission[]
  parentRoleId String?
  isActive     Boolean      @default(true)
  isSystem     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  parentRole   Role?        @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  childRoles   Role[]       @relation("RoleHierarchy")
  userRoles    UserRole[]

  @@map("roles")
}

model UserRole {
  id             String         @id @default(uuid())
  userId         String
  roleId         String
  organizationId String?
  assignedById   String?
  assignedAt     DateTime       @default(now())
  expiresAt      DateTime?
  isActive       Boolean        @default(true)
  assignedBy     User?          @relation("AssignedRoles", fields: [assignedById], references: [id])
  organizations  organizations? @relation(fields: [organizationId], references: [id])
  role           Role           @relation(fields: [roleId], references: [id])
  user           User           @relation(fields: [userId], references: [id])

  @@unique([userId, roleId, organizationId])
  @@map("user_roles")
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  permission   Permission
  isGranted    Boolean    @default(true)
  assignedById String?
  assignedAt   DateTime   @default(now())
  assignedBy   User?      @relation("AssignedPermissions", fields: [assignedById], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@unique([userId, permission])
  @@map("user_permissions")
}

model Invitation {
  id                   String               @id @default(uuid())
  organizationId       String
  hunterId             String
  driverId             String
  status               InvitationStatus     @default(PENDING)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  driver               DriverProfile        @relation(fields: [driverId], references: [id])
  organization_members organization_members @relation(fields: [hunterId], references: [id])
  organizations        organizations        @relation(fields: [organizationId], references: [id])

  @@map("invitations")
}

model DocumentVerification {
  id                     String                   @id @default(uuid())
  userId                 String
  documentType           VerificationDocumentType
  documentImageUrl       String
  fileSize               Int?
  mimeType               String?
  extractedData          Json?
  isValid                Boolean                  @default(false)
  validationErrors       Json?
  confidenceScore        Float?
  status                 VerificationStatus       @default(PENDING)
  verifiedAt             DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  biometricVerifications BiometricVerification[]
  user                   User                     @relation(fields: [userId], references: [id])

  @@map("document_verifications")
}

model BiometricVerification {
  id                     String               @id @default(uuid())
  userId                 String
  documentVerificationId String
  selfieImageUrl         String
  fileSize               Int?
  mimeType               String?
  matchScore             Float?
  livenessScore          Float?
  isMatch                Boolean              @default(false)
  isLive                 Boolean              @default(false)
  status                 VerificationStatus   @default(PENDING)
  verifiedAt             DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  documentVerification   DocumentVerification @relation(fields: [documentVerificationId], references: [id])
  user                   User                 @relation(fields: [userId], references: [id])

  @@map("biometric_verifications")
}

model Occurrence {
  id                String                @id @default(uuid())
  obNumber          String                @unique @map("ob_number")
  category          OccurrenceCategory
  severity          OccurrenceSeverity
  title             String                @db.VarChar(255)
  description       String
  driverId          String?               @map("driver_id")
  passengerId       String?               @map("passenger_id")
  vehicleId         String?               @map("vehicle_id")
  rideId            String?               @map("ride_id")
  occurrenceDate    DateTime              @map("occurrence_date") @db.Date
  occurrenceTime    DateTime              @map("occurrence_time") @db.Time(6)
  occurredAt        DateTime              @map("occurred_at")
  locationLat       Decimal?              @map("location_lat") @db.Decimal(10, 8)
  locationLng       Decimal?              @map("location_lng") @db.Decimal(11, 8)
  locationAddress   String?               @map("location_address")
  locationPlaceName String?               @map("location_place_name") @db.VarChar(255)
  locationCity      String?               @map("location_city") @db.VarChar(100)
  locationCountry   String                @default("Kenya") @map("location_country") @db.VarChar(100)
  locationDetails   Json?                 @map("location_details")
  source            String
  sourceReferenceId String?               @map("source_reference_id")
  registeredById    String                @map("registered_by")
  registeredAt      DateTime              @default(now()) @map("registered_at")
  status            OccurrenceStatus      @default(OPEN)
  resolvedAt        DateTime?             @map("resolved_at")
  resolvedById      String?               @map("resolved_by")
  resolutionNotes   String?               @map("resolution_notes")
  tags              String[]
  isFlagged         Boolean               @default(false) @map("is_flagged")
  flagReason        String?               @map("flag_reason")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  auditLog          OccurrenceAuditLog[]
  media             OccurrenceMedia[]
  objections        OccurrenceObjection[]
  driver            DriverProfile?        @relation("DriverOccurrences", fields: [driverId], references: [id])
  passenger         User?                 @relation("PassengerOccurrences", fields: [passengerId], references: [id])
  registeredBy      User                  @relation("RegisteredOccurrences", fields: [registeredById], references: [id])
  resolvedBy        User?                 @relation("ResolvedOccurrences", fields: [resolvedById], references: [id])
  ride              Ride?                 @relation("RideOccurrences", fields: [rideId], references: [id])
  vehicle           Vehicle?              @relation("VehicleOccurrences", fields: [vehicleId], references: [id])

  @@index([status])
  @@index([severity])
  @@index([category])
  @@index([occurrenceDate])
  @@index([driverId])
  @@index([passengerId])
  @@map("occurrences")
}

model OccurrenceMedia {
  id           String     @id @default(uuid())
  occurrenceId String     @map("occurrence_id")
  mediaType    String     @map("media_type")
  fileUrl      String     @map("file_url")
  thumbnailUrl String?    @map("thumbnail_url")
  fileSize     Int?       @map("file_size")
  mimeType     String?    @map("mime_type") @db.VarChar(100)
  duration     Int?
  uploadedById String?    @map("uploaded_by")
  uploadedAt   DateTime   @default(now()) @map("uploaded_at")
  description  String?
  metadata     Json?
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  uploadedBy   User?      @relation("UploadedOccurrenceMedia", fields: [uploadedById], references: [id])

  @@map("occurrence_media")
}

model OccurrenceObjection {
  id                 String          @id @default(uuid())
  occurrenceId       String          @map("occurrence_id")
  objectorId         String          @map("objector_id")
  objectionText      String          @map("objection_text")
  supportingEvidence Json?           @map("supporting_evidence")
  status             ObjectionStatus @default(PENDING)
  reviewedById       String?         @map("reviewed_by")
  reviewedAt         DateTime?       @map("reviewed_at")
  reviewNotes        String?         @map("review_notes")
  outcome            String?         @db.VarChar(50)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  objector           User            @relation("FiledObjections", fields: [objectorId], references: [id])
  occurrence         Occurrence      @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  reviewedBy         User?           @relation("ReviewedObjections", fields: [reviewedById], references: [id])

  @@map("occurrence_objections")
}

model OccurrenceAuditLog {
  id           String     @id @default(uuid())
  occurrenceId String     @map("occurrence_id")
  action       String     @db.VarChar(50)
  actorId      String?    @map("actor_id")
  changes      Json?
  notes        String?
  createdAt    DateTime   @default(now()) @map("created_at")
  actor        User?      @relation("OccurrenceAuditActions", fields: [actorId], references: [id])
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@map("occurrence_audit_log")
}

model Badge {
  id                  String               @id @default(uuid())
  code                String               @unique
  name                String
  description         String
  iconUrl             String?
  category            BadgeCategory
  tier                BadgeTier            @default(BRONZE)
  criteria            Json
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  badgeRewardMappings    BadgeRewardMapping[]
  sosConfigs             SosConfig[]
  userBadges             UserBadge[]
  wealthProgramsRequired WealthProgram[]          @relation("WealthProgramRequiredBadge")
  wealthIncentives       BadgeWealthIncentive[]

  @@map("badges")
}

model UserBadge {
  id              String         @id @default(uuid())
  userId          String
  badgeId         String
  earnedAt        DateTime       @default(now())
  progress        Int?
  driverProfileId String?
  badge           Badge          @relation(fields: [badgeId], references: [id])
  DriverProfile   DriverProfile? @relation(fields: [driverProfileId], references: [id])
  user            User           @relation(fields: [userId], references: [id])

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model Reward {
  id                  String               @id @default(uuid())
  code                String               @unique
  name                String
  description         String
  type                RewardType
  value               Json
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  badgeRewardMappings BadgeRewardMapping[]

  @@map("rewards")
}

model BadgeRewardMapping {
  id        String   @id @default(uuid())
  badgeId   String
  rewardId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  badge     Badge    @relation(fields: [badgeId], references: [id])
  reward    Reward   @relation(fields: [rewardId], references: [id])

  @@unique([badgeId, rewardId])
  @@map("badge_reward_mappings")
}

model DriverBadgeStatus {
  id              String        @id @default(uuid())
  driverProfileId String
  badgeTier       BadgeTier
  isActive        Boolean       @default(true)
  earnedAt        DateTime      @default(now())
  expiresAt       DateTime?
  lastValidatedAt DateTime?
  metricsSnapshot Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id])

  @@unique([driverProfileId, badgeTier])
  @@map("driver_badge_status")
}

model DriverSavingsPreference {
  id                   String        @id @default(uuid())
  driverProfileId      String        @unique
  personalSavingRate   Float         @default(0.0)
  isAutoSavingsEnabled Boolean       @default(false)
  preferredZoneIds     String[]      @default([])
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  driverProfile        DriverProfile @relation(fields: [driverProfileId], references: [id])

  @@map("driver_savings_preferences")
}

model TransactionLedger {
  id                    String        @id @default(uuid())
  tripId                String?
  driverProfileId       String
  baseFare              Decimal       @db.Decimal(10, 2)
  platformCommission    Decimal       @db.Decimal(10, 2)
  platformNet           Decimal       @db.Decimal(10, 2)
  saccoAdminFee         Decimal       @db.Decimal(10, 2)
  badgeBonusActive      Boolean       @default(false)
