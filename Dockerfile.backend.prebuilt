# ==============================================================================
# CABI AFRICA - MULTI-STAGE DOCKERFILE FOR NX MONOREPO SERVICES
# ==============================================================================

# Stage 1: Build the specific service
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY package-lock.json ./
RUN npm ci --legacy-peer-deps --ignore-scripts

COPY nx.json ./
COPY tsconfig.base.json ./
COPY libs ./libs
COPY auth-gateway ./auth-gateway
COPY backend ./backend
COPY scripts ./scripts

RUN npx prisma generate --schema=libs/backend/database/prisma/schema.prisma

ARG SERVICE_NAME
ENV NODE_OPTIONS=--max-old-space-size=2048
RUN npx nx build $SERVICE_NAME --configuration=production

# Stage 2: Production Runner (minimal Alpine image)
FROM node:20-alpine

RUN apk add --no-cache openssl
WORKDIR /app

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nestjs

COPY --from=builder --chown=nestjs:nodejs /app/dist ./dist
COPY --from=builder --chown=nestjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nestjs:nodejs /app/scripts/start-service.sh ./start-service.sh
RUN sed -i 's/\r$//' ./start-service.sh && chmod +x ./start-service.sh

ARG SERVICE_NAME
ARG IS_BACKEND_SUB_SERVICE=true
ENV SERVICE_NAME=${SERVICE_NAME}
ENV IS_BACKEND_SUB_SERVICE=${IS_BACKEND_SUB_SERVICE}
ENV NODE_ENV=production

USER nestjs

EXPOSE 8080

CMD ["./start-service.sh"]