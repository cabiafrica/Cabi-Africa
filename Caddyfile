        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    request_body {
        max_size 10MB
    }

    handle /health {
        respond "Cabi Africa Production Platform Active" 200
    }

    handle /google6c1eda6c9d42f1d9.html {
        respond "google-site-verification: google6c1eda6c9d42f1d9.html" 200
    }

    handle /delete-account {
        header Content-Type "text/html; charset=utf-8"
        respond `<!DOCTYPE html><html><head><title>CABI Africa - Account Deletion</title><meta name="viewport" content="width=device-width,initial-scale=1"></head><body style="font-family:system-ui,sans-serif;max-width:600px;margin:40px auto;padding:20px;line-height:1.6"><h1>CABI Africa - Account Deletion Request</h1><p>At CABI Africa, we respect your privacy and give you full control over your personal data.</p><p>To request permanent deletion of your CABI account and all associated personal data (including profile details, ride history, and location data), you can either:</p><ol><li><strong>In-App:</strong> Go to Profile &gt; Settings &gt; Delete Account within the CABI Go or CABI Drive app.</li><li><strong>Via Email:</strong> Send an email from your registered email address to <a href="mailto:support@cabi.africa">support@cabi.africa</a> with the subject "Delete My Account".</li></ol><p>Your account and associated personal data will be permanently removed within 30 days of your request.</p></body></html>` 200
    }

    handle /privacy {
        header Content-Type "text/html; charset=utf-8"
        respond `<!DOCTYPE html><html><head><title>CABI Africa - Privacy Policy</title><meta name="viewport" content="width=device-width,initial-scale=1"></head><body style="font-family:system-ui,sans-serif;max-width:700px;margin:40px auto;padding:20px;line-height:1.6"><h1>CABI Africa - Privacy Policy</h1><p>Last updated: November 2026</p><p>CABI FAST AFRICA LIMITED operates the CABI Go and CABI Drive mobile applications. This policy explains how we collect, use, and protect your personal information.</p><h2>1. Information We Collect</h2><p>• <strong>Account Info:</strong> Name, phone number, email address.<br>• <strong>Location Data:</strong> Real-time precise and approximate GPS coordinates to enable ride dispatch, live trip tracking, and navigation.<br>• <strong>Payment Info:</strong> Transaction records for ride payments.</p><h2>2. How We Use Information</h2><p>We use your data to match passengers with drivers, calculate fares, facilitate trip safety and SOS alerts, and provide customer support.</p><h2>3. Data Protection & Sharing</h2><p>All data is encrypted in transit using industry-standard TLS/SSL. We do not sell your personal data to third parties.</p><h2>4. Contact Us</h2><p>For questions or privacy requests, contact us at <a href="mailto:support@cabi.africa">support@cabi.africa</a>.</p></body></html>` 200
    }

    @websockets {
