{
  "name": "cabi-monorepo",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve",
    "dev:all": "npx concurrently \"npm run serve:backend\" \"npm run dev:web\"",
    "dev:web": "npx concurrently \"npm run dev:admin\" \"npm run dev:user\" \"npm run dev:dispatch\"",
    "dev:admin": "cd web/admin_panel && npm run dev",
    "dev:user": "cd web/user_portal && npm run dev",
    "dev:dispatch": "cd web/dispatch_panel && npm run dev",
    "build": "nx build",
    "test": "nx test --all",
    "lint": "nx run-many --target=lint --all --parallel=3",
    "lint:web": "nx run-many --target=lint --projects=user-portal,admin-panel,dispatch-panel --parallel=3",
    "lint:backend": "nx run-many --target=lint --projects=auth-gateway,admin-service,user-service,verification-service,dispatch-service,driver-lead-service --parallel=3",
    "build:web": "nx run-many --target=build --projects=user-portal,admin-panel,dispatch-panel --parallel=3",
    "build:backend": "nx run-many --target=build --projects=auth-gateway,admin-service,user-service,verification-service,dispatch-service,driver-lead-service,referral-service,sacco-service --parallel=3",
    "serve:backend": "nx run-many --target=serve --projects=auth-gateway,admin-service,user-service,verification-service,dispatch-service,driver-lead-service,referral-service,sacco-service --parallel=10",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "launch:prepare": "node scripts/prepare-for-launch.js",
    "launch:list-users": "node scripts/list-users.js",
    "admin:recreate": "node scripts/recreate-super-admin.js",
    "admin:verify": "node scripts/verify-admin-final.js",
    "db:clean": "ts-node scripts/clean_data.ts",
    "db:seed-roles": "ts-node scripts/seed_roles.ts"
  },
  "private": true,
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
