{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "driver-app",
      "cwd": "apps\\driver-app",
      "request": "launch",
      "type": "dart"
    },
    {
      "name": "driver-app (profile mode)",
      "cwd": "apps\\driver-app",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile"
    },
    {
      "name": "driver-app (release mode)",
      "cwd": "apps\\driver-app",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release"
    },
    {
      "name": "passenger-app",
      "cwd": "apps\\passenger-app",
      "request": "launch",
      "type": "dart"
    },
    {
      "name": "passenger-app (profile mode)",
      "cwd": "apps\\passenger-app",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile"
    },
    {
      "name": "passenger-app (release mode)",
      "cwd": "apps\\passenger-app",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release"
    },
    {
      "name": "api",
      "cwd": "apps\\passenger-app\\src\\api",
      "request": "launch",
      "type": "dart"
    },
    {
      "name": "screens",
      "cwd": "apps\\passenger-app\\src\\screens",
      "request": "launch",
      "type": "dart"
    },
    {
      "name": "screens (profile mode)",
      "cwd": "apps\\passenger-app\\src\\screens",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile"
    },
    {
      "name": "screens (release mode)",
      "cwd": "apps\\passenger-app\\src\\screens",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug auth-gateway with Nx",
      "runtimeExecutable": "pnpm exec",
      "runtimeArgs": ["nx", "serve", "auth-gateway"],
      "env": {
        "NODE_OPTIONS": "--inspect=9229"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/auth-gateway/dist/**/*.(m|c|)js",
        "!**/node_modules/**"
      ]
    }
  ]
}
