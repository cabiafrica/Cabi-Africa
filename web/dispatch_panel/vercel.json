{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/dispatch/(.*)",
      "destination": "https://auth-gateway-746659778850.us-central1.run.app/api/dispatch/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://auth-gateway-746659778850.us-central1.run.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
