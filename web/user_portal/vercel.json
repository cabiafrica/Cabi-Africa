{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/dispatch/:path*",
      "destination": "https://auth-gateway-746659778850.us-central1.run.app/api/dispatch/:path*"
    },
    {
      "source": "/api/verification/:path*",
      "destination": "https://auth-gateway-746659778850.us-central1.run.app/api/verification/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://auth-gateway-746659778850.us-central1.run.app/api/:path*"
    }
  ]
}
