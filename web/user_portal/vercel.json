{
  "ignoreCommand": "exit 0",
  "git": {
    "deploymentEnabled": false
  },
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/dispatch/:path*",
      "destination": "https://api.cabi.africa/api/dispatch/:path*"
    },
    {
      "source": "/api/verification/:path*",
      "destination": "https://api.cabi.africa/api/verification/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.cabi.africa/api/:path*"
    }
  ]
}
