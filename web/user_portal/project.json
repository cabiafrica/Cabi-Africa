{
  "name": "user-portal",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "web/user_portal",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/web/user_portal"
      },
      "configurations": {
        "development": {
          "outputPath": "dist/web/user_portal-development"
        },
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "user-portal:build",
        "dev": true
      },
      "configurations": {
        "development": {
          "buildTarget": "user-portal:build:development",
          "dev": true
        },
        "production": {
          "buildTarget": "user-portal:build:production",
          "dev": false
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "web/user_portal/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": []
}