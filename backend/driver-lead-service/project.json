{
  "name": "driver-lead-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "backend/driver-lead-service/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx webpack-cli build",
        "args": [
          "--node-env=production"
        ],
        "cwd": "backend/driver-lead-service"
      },
      "configurations": {
        "development": {
          "args": [
            "--node-env=development"
          ]
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "options": {
        "buildTarget": "driver-lead-service:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "driver-lead-service:build:development"
        }
      }
    }
  }
}