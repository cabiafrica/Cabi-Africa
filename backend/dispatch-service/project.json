{
    "name": "dispatch-service",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "backend/dispatch-service/src",
    "projectType": "application",
    "tags": [],
    "targets": {
        "build": {
            "executor": "@nx/nest:build",
            "outputs": [
                "{options.outputPath}"
            ],
            "options": {
                "outputPath": "dist/backend/dispatch-service",
                "main": "backend/dispatch-service/src/main.ts",
                "tsConfig": "backend/dispatch-service/tsconfig.app.json"
            }
        },
        "serve": {
            "executor": "@nx/nest:serve",
            "options": {
                "buildTarget": "dispatch-service:build"
            }
        }
    }
}