{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/out-tsc",
        "tsBuildInfoFile": "../../dist/out-tsc/referral-service.tsbuildinfo",
        "types": [
            "node"
        ]
    },
    "files": [
        "src/main.ts"
    ],
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "src/**/*.spec.ts",
        "src/__tests__/**/*.ts"
    ]
}