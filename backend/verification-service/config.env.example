# Verification Service Environment Configuration

# ===========================================
# SERVER CONFIGURATION
# ===========================================
NODE_ENV=development
PORT=3003

# ===========================================
# DATABASE (Optional - for future use)
# ===========================================
DATABASE_URL=postgresql://user:password@localhost:5432/cabi_africa
DIRECT_URL=postgresql://user:password@localhost:5432/cabi_africa

# ===========================================
# FILE STORAGE
# ===========================================
UPLOAD_DIR=./uploads/documents
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_MIME_TYPES=image/jpeg,image/jpg,image/png,application/pdf

# ===========================================
# AI/OCR CONFIGURATION
# ===========================================
TESSERACT_WORKERS=4
OCR_CONFIDENCE_THRESHOLD=0.7
DOCUMENT_QUALITY_THRESHOLD=0.5

# ===========================================
# VERIFICATION CONFIGURATION
# ===========================================
MAX_FREE_TRIPS=1
SELFIE_REVERIFICATION_DAYS=30
FINGERPRINT_REVERIFICATION_DAYS=90
AUTO_VERIFY_ON_UPLOAD=true
REQUIRE_ADMIN_APPROVAL=false

# ===========================================
# NOTIFICATIONS (SMS/Email)
# ===========================================
# Twilio Configuration
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@cabi.africa

# ===========================================
# PUSH NOTIFICATIONS
# ===========================================
# Firebase Cloud Messaging
FCM_SERVER_KEY=your_fcm_server_key

# ===========================================
# WEBHOOK CONFIGURATION
# ===========================================
VERIFICATION_WEBHOOK_URL=
WEBHOOK_SECRET=

# ===========================================
# SECURITY
# ===========================================
API_KEY=your_api_key_here
JWT_SECRET=your_jwt_secret_here

# ===========================================
# EXTERNAL SERVICES
# ===========================================
# AWS Rekognition (for advanced face detection)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1

# ===========================================
# APPLICATION URLs
# ===========================================
APP_URL=https://cabi.africa
PASSENGER_APP_URL=https://passenger.cabi.africa
DRIVER_APP_URL=https://driver.cabi.africa
ADMIN_PANEL_URL=https://admin.cabi.africa
