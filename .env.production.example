# Environment Variables for High-Scale Deployment

## Database Configuration

# Primary Database (Writes)
DATABASE_WRITE_URL="postgresql://user:password@primary-db.region.provider.com:5432/cabi?pgbouncer=true&connection_limit=100"
DIRECT_URL="postgresql://user:password@primary-db.region.provider.com:5432/cabi"

# Read Replicas
DATABASE_READ_URL="postgresql://user:password@read-replica.region.provider.com:5432/cabi?pgbouncer=true&connection_limit=100"

# Geographic Shards (Optional - for multi-region)
DB_EAST_AFRICA_WRITE_URL="postgresql://user:password@ea-primary.region.provider.com:5432/cabi"
DB_EAST_AFRICA_READ_URL="postgresql://user:password@ea-replica.region.provider.com:5432/cabi"
DB_SOUTH_AFRICA_WRITE_URL="postgresql://user:password@sa-primary.region.provider.com:5432/cabi"
DB_SOUTH_AFRICA_READ_URL="postgresql://user:password@sa-replica.region.provider.com:5432/cabi"
DB_WEST_AFRICA_WRITE_URL="postgresql://user:password@wa-primary.region.provider.com:5432/cabi"
DB_WEST_AFRICA_READ_URL="postgresql://user:password@wa-replica.region.provider.com:5432/cabi"

## Redis Configuration

# Redis Cluster Nodes
REDIS_NODE_1_HOST="redis-node-1.cache.provider.com"
REDIS_NODE_2_HOST="redis-node-2.cache.provider.com"
REDIS_NODE_3_HOST="redis-node-3.cache.provider.com"
REDIS_PASSWORD="your-redis-password"

# Redis Pub/Sub (separate instance)
REDIS_PUBSUB_HOST="redis-pubsub.cache.provider.com"
REDIS_PUBSUB_PORT="6379"

## Message Queue (Kafka)

KAFKA_BROKERS="kafka-1.provider.com:9092,kafka-2.provider.com:9092,kafka-3.provider.com:9092"
KAFKA_CLIENT_ID="cabi-backend"
KAFKA_GROUP_ID="cabi-consumer-group"
KAFKA_SASL_USERNAME="your-kafka-username"
KAFKA_SASL_PASSWORD="your-kafka-password"

## Application Configuration

NODE_ENV="production"
PORT="3000"
API_VERSION="v1"

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS="1000"
RATE_LIMIT_WINDOW_SECONDS="60"

# Connection Pooling
DB_POOL_MIN="20"
DB_POOL_MAX="100"
DB_IDLE_TIMEOUT_MS="30000"
DB_CONNECTION_TIMEOUT_MS="2000"

## Monitoring & Logging

# Datadog
DATADOG_API_KEY="your-datadog-api-key"
DATADOG_APP_KEY="your-datadog-app-key"
DATADOG_SERVICE_NAME="cabi-backend"

# Sentry
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
SENTRY_ENVIRONMENT="production"

## External Services

# Payment Gateway
PAYMENT_GATEWAY_URL="https://api.payment-provider.com"
PAYMENT_GATEWAY_API_KEY="your-payment-api-key"

# SMS/Notifications
SMS_PROVIDER_URL="https://api.sms-provider.com"
SMS_PROVIDER_API_KEY="your-sms-api-key"

# Push Notifications
FCM_SERVER_KEY="your-fcm-server-key"
FCM_PROJECT_ID="your-fcm-project-id"

## Security

JWT_SECRET="your-super-secret-jwt-key-min-32-characters"
JWT_EXPIRATION="24h"
REFRESH_TOKEN_EXPIRATION="7d"

# Encryption
ENCRYPTION_KEY="your-encryption-key-32-characters-long"
ENCRYPTION_ALGORITHM="aes-256-gcm"

## Feature Flags

ENABLE_GEOGRAPHIC_SHARDING="false"
ENABLE_RATE_LIMITING="true"
ENABLE_CACHING="true"
ENABLE_REAL_TIME_LOCATION="true"

## Performance Tuning

# Cache TTLs (seconds)
CACHE_TTL_USER_DATA="3600"
CACHE_TTL_SESSION="86400"
CACHE_TTL_DRIVER_LOCATION="30"
CACHE_TTL_NEARBY_DRIVERS="10"

# Query Timeouts (milliseconds)
DB_QUERY_TIMEOUT="5000"
CACHE_QUERY_TIMEOUT="1000"
API_REQUEST_TIMEOUT="30000"

## Scaling Configuration

# Auto-scaling thresholds
MIN_INSTANCES="5"
MAX_INSTANCES="50"
TARGET_CPU_UTILIZATION="70"
TARGET_MEMORY_UTILIZATION="80"

# Load balancer
LOAD_BALANCER_URL="https://lb.cabi-africa.com"
HEALTH_CHECK_PATH="/health"
HEALTH_CHECK_INTERVAL="30"

## Backup & Recovery

BACKUP_ENABLED="true"
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS="30"
POINT_IN_TIME_RECOVERY="true"

## Google Maps Platform
GOOGLE_MAPS_API_KEY="AIzaSyA_ybfC1sxL4K92fKiuIsfHLkFK7sWl9-0"
